{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanfeilong/cefutil/src/xgoef/xgoef.conf.schema.json",
  "title": "xgoef.conf.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "productName": { "type": "string" },
    "version": { "type": "string" },
    "identifier": { "type": "string" },
    "build": {
      "type": "object",
      "properties": {
        "frontendDist": { "type": "string", "default": "web" },
        "devUrl": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "default": "main" },
              "title": { "type": "string" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "url": { "type": "string" }
            },
            "required": ["title", "width", "height"]
          }
        }
      }
    },
    "cef": {
      "type": "object",
      "properties": {
        "rootEnv": { "type": "string", "default": "CEF_ROOT" },
        "noSandbox": { "type": "boolean", "default": true },
        "cacheDir": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "description": "Tauri-like capability list (P0 ACL). Legacy map form is also accepted by the loader.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "identifier": { "type": "string" },
              "windows": {
                "type": "array",
                "items": { "type": "string" }
              },
              "permissions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["identifier", "permissions"]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "commands": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  },
  "required": ["productName", "app"]
}
