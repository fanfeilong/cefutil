# Hello — minimal xgoef app in idiomatic XGo.
# Spec philosophy (goplus/xgo): command style, ErrWrap, lambda, ${expr}.
# Build: ./scripts/build-xgoef-hello.sh  →  xgo build (LLGo, no cgo)

import (
	"encoding/json"
	"os"
	"path/filepath"
	"runtime"

	"github.com/fanfeilong/cefutil/src/xgoef/cef"
	"github.com/fanfeilong/cefutil/src/xgoef/conf"
	xruntime "github.com/fanfeilong/cefutil/src/xgoef/runtime"
)

func isCEFSwitch(s string) bool {
	return len(s) > 1 && s[0] == '-'
}

func resolveFileURL(base, u string) string {
	if u == "" {
		return "file://" + filepath.Join(base, "web", "index.html")
	}
	if len(u) >= 7 && u[:7] == "file://" {
		p := u[7:]
		if !filepath.IsAbs(p) {
			return "file://" + filepath.Join(base, p)
		}
	}
	return u
}

# CEF helpers re-enter this executable — pin the OS thread first.
runtime.LockOSThread

host := cef.NewNativeHost()
if host == nil {
	fatal cef.ErrBindingsMissing
}

host.SetArgs os.Args
host.InitAPIHash()!

if code, helper := host.ExecuteProcess(); helper {
	os.Exit code
}

cfgPath := "xgoef.conf.json"
if len(os.Args) > 1 && !isCEFSwitch(os.Args[1]) {
	cfgPath = os.Args[1]
} else if _, err := os.Stat(cfgPath); err != nil {
	cfgPath = filepath.Join("examples", "hello", "xgoef.conf.json")
}

abs := filepath.Abs(cfgPath)!
cfg := conf.Load(abs)!

base := filepath.Dir(abs)
if cfg.CEF.CacheDir != "" && !filepath.IsAbs(cfg.CEF.CacheDir) {
	cfg.CEF.CacheDir = filepath.Join(base, cfg.CEF.CacheDir)
}
webURL := ""
if len(cfg.App.Windows) > 0 {
	cfg.App.Windows[0].URL = resolveFileURL(base, cfg.App.Windows[0].URL)
	webURL = cfg.App.Windows[0].URL
}

app := xruntime.New(cfg, host)
app.Handle "greet", (ctx, argsJSON) => {
	name := "world"
	if len(argsJSON) > 0 {
		var args struct {
			Name string `json:"name"`
		}
		json.Unmarshal argsJSON, &args
		if args.Name != "" {
			name = args.Name
		}
	}
	# Host → renderer event (P1).
	app.EmitTo "main", "tick", map[string]any{
		"n":    1,
		"from": "greet",
	}
	return "hello, ${name} (from xgoef)", nil
}
app.Handle "open_aux", (ctx, argsJSON) => {
	err := app.CreateWindow(cef.WindowSpec{
		Label:  "aux",
		Title:  "xgoef aux",
		URL:    webURL,
		Width:  720,
		Height: 480,
	})
	if err != nil {
		return nil, err
	}
	return "opened aux", nil
}

if err := app.Run(); err != nil {
	if ee, ok := err.(*xruntime.ExitError); ok {
		os.Exit ee.Code
	}
	fatal "xgoef-hello: ${err}"
}
