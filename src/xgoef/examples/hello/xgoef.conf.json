{
  "productName": "xgoef-hello",
  "version": "0.0.1",
  "identifier": "com.example.xgoef.hello",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xgoef hello",
        "width": 960,
        "height": 640,
        "url": "file://web/index.html"
      }
    ]
  },
  "cef": {
    "rootEnv": "CEF_ROOT",
    "noSandbox": true,
    "cacheDir": "root_cache"
  },
  "plugins": [],
  "capabilities": [
    {
      "identifier": "main",
      "windows": ["main"],
      "permissions": ["greet", "open_aux", "core:default"]
    },
    {
      "identifier": "aux",
      "windows": ["aux"],
      "permissions": ["greet", "core:default"]
    }
  ]
}
